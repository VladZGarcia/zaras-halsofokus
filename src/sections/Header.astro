---
import "../styles/hamburger.css";
---

<script>
  // Toggle navigation menu on hamburger click
  document.addEventListener("DOMContentLoaded", () => {
    const hamburger = document.getElementById("hamburger");
    const navMenu = document.getElementById("nav-menu");
    const headerCta = document.getElementById("header-cta");
    const homeLinks = document.querySelectorAll(
      'a[href="/#home"], a[href="#home"]',
    );
    const servicesLinks = document.querySelectorAll(
      'a[href="/#services"], a[href="#services"]',
    );
    const lpgLinks = document.querySelectorAll(
      'a[href="/#lpg"], a[href="#lpg"]',
    );
    const insculptLinks = document.querySelectorAll(
      'a[href="/#insculpt"], a[href="#insculpt"]',
    );
    const servicesSection = document.getElementById("services");
    const lpgSection = document.getElementById("lpg");
    const insculptSection = document.getElementById("insculpt");
    const homeSection = document.getElementById("home");

    if (!hamburger || !navMenu) return;
    const closeMenu = () => {
      hamburger.classList.remove("active");
      navMenu.classList.remove("active");
    };
    hamburger.addEventListener("click", () => {
      hamburger.classList.toggle("active");
      navMenu.classList.toggle("active");
    });

    // Close when clicking outside the menu or hamburger
    document.addEventListener("click", (e) => {
      if (!navMenu.classList.contains("active")) return;
      const target = e.target as HTMLElement;
      if (!navMenu.contains(target) && !hamburger.contains(target)) {
        closeMenu();
      }
    });

    // Close on ESC key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && navMenu.classList.contains("active")) {
        closeMenu();
      }
    });

    // Smooth scroll on homepage; navigate on other pages
    const onHome = location && location.pathname === "/";
    // Show CTA in header only when not viewing the hero section (#home)
    if (headerCta) {
      const showCta = () => headerCta.classList.remove("hidden");
      const hideCta = () => headerCta.classList.add("hidden");
      if (onHome && homeSection && "IntersectionObserver" in window) {
        // Initialize based on current viewport
        const rect = homeSection.getBoundingClientRect();
        const inView = rect.top < window.innerHeight && rect.bottom > 0;
        if (inView) hideCta();
        else showCta();

        const observer = new IntersectionObserver(
          ([entry]) => {
            if (!entry) return;
            if (entry.isIntersecting && entry.intersectionRatio > 0.2) {
              hideCta();
            } else {
              showCta();
            }
          },
          { threshold: [0, 0.2, 0.5, 1] },
        );
        observer.observe(homeSection);
      } else {
        // On non-home pages (no hero), always show CTA
        showCta();
      }
    }
    if (onHome && homeSection) {
      homeLinks.forEach((link) =>
        link.addEventListener("click", (e) => {
          e.preventDefault();
          homeSection.scrollIntoView({ behavior: "smooth", block: "start" });
          closeMenu();
        }),
      );
    }
    if (onHome && servicesSection) {
      servicesLinks.forEach((link) =>
        link.addEventListener("click", (e) => {
          e.preventDefault();
          servicesSection.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
          closeMenu();
        }),
      );
    }
    if (onHome && lpgSection) {
      lpgLinks.forEach((link) =>
        link.addEventListener("click", (e) => {
          e.preventDefault();
          lpgSection.scrollIntoView({ behavior: "smooth", block: "start" });
          closeMenu();
        }),
      );
    }
    if (onHome && insculptSection) {
      insculptLinks.forEach((link) =>
        link.addEventListener("click", (e) => {
          e.preventDefault();
          insculptSection.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
          closeMenu();
        }),
      );
    }

    // Also close when any nav link is clicked (for non-home navigation)
    const allNavLinks = navMenu.querySelectorAll("a[href]");
    allNavLinks.forEach((link) =>
      link.addEventListener("click", () => closeMenu()),
    );
  });
</script>

<header class="fixed top-0 left-0 right-0 z-50 w-full bg-transparent">
  <div class="text-white py-4">
    <div class="container mx-auto px-4 py-2 flex items-center">
      <a href="https://www.zarashalsofokus.com" class="inline-block">
        <span
          class="inline-flex items-center rounded-lg bg-black/20 hover:bg-black/30 md:bg-black/10 p-1 sm:p-2 md:p-3"
        >
          <img
            src="/zaras-halsofokus-logo.png"
            alt="zaras-halsofokus-logo"
            class="w-36 h-12 sm:w-44 sm:h-16 md:w-56 md:h-20 lg:w-64 lg:h-24 animate-fade-in-up brightness-100 invert"
          />
        </span>
      </a>

      <!-- Right-side actions: CTA + Hamburger -->
      <div class="flex items-center gap-2 md:gap-9 ml-auto">
        <!-- Header CTA: visible when hero not in view or on non-home pages -->
        <a
          id="header-cta"
          href="https://www.bokadirekt.se/places/zaras-halsofokus-40836"
          aria-label="Boka tid"
          class="hidden inline-flex items-center justify-center bg-blue-500 text-white px-2.5 py-1.5 text-xs rounded-full hover:bg-blue-600 transition whitespace-nowrap sm:px-3 sm:py-1.5 sm:text-sm lg:px-5 lg:py-2.5 lg:text-base"
        >
          Boka Nu
        </a>

        <!-- Hamburger Menu Button -->
        <button
          id="hamburger"
          class="flex flex-col cursor-pointer"
          aria-label="Meny"
        >
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>
      </div>

      <!-- Navigation Menu -->
      <nav id="nav-menu" class="nav-menu">
        <ul
          class="flex flex-col md:space-x-6 md:space-y-4 space-y-0 items-center"
        >
          <li><a href="/#home" class="hover:text-gray-400">Hem</a></li>
          <li><a href="/#services" class="hover:text-gray-400">Tjänster</a></li>
          <li><a href="/#lpg" class="hover:text-gray-400">LPG</a></li>
          <li><a href="/#insculpt" class="hover:text-gray-400">Insculpt</a></li>
          <li><a href="/aboutUs" class="hover:text-gray-400">Om oss</a></li>
          <li><a href="/contact" class="hover:text-gray-400">Kontakt</a></li>
          <ul
            class="flex flex-col md:flex-row md:justify-center md:space-x-6 space-y-4 md:space-y-0 items-center"
          >
          </ul>
        </ul>
      </nav>
    </div>
  </div>
</header>
