---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section
    class="min-h-screen flex items-center justify-center bg-[#2f2011] under-header"
  >
    <div class="px-6 py-12 text-center max-w-3xl">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">Mer om LPG</h1>
      <p class="text-lg md:text-xl mb-8">
        Härliga, Hälsosamma LPG! LPG är en djupgående bindvävsmassage som ökar
        blodcirkulationen i kroppen och sätter bl.a. igång lymfcirkulationen.
        Det bidrar till att slaggprodukter, toxiner och överflödig vätska
        lättare kan föras ut ur kroppen, att svullnader minskar och kroppen får
        ny energi!
      </p>
      <a
        href="/"
        class="inline-block px-6 py-3 rounded-md border border-white/40 bg-white/15 text-white hover:bg-white/25 hover:border-white/60 transition"
        >Tillbaka</a
      >
    </div>
  </section>
</Layout>
