---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <!-- Insculpt Chair Section -->
  <section class="bg-[#a89d91] py-16">
    <div class="max-w-6xl mx-auto px-6 text-black">
      <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center">
        Insculpt Chair – Revolutionerande stolbehandling
      </h2>

      <div class="grid md:grid-cols-2 gap-12 items-center mb-12">
        <!-- Text Content -->
        <div>
          <h3 class="text-2xl md:text-3xl font-semibold mb-4">
            Stärk bäckenbotten och forma rumpa samtidigt
          </h3>
          <p class="text-lg mb-6">
            Insculpt Chair är en banbrytande behandling som kombinerar
            HIFEM-teknologi (högintensiv fokuserad elektromagnetisk energi) med
            bekväm stoldesign. Perfekt för dig som vill stärka bäckenbotten,
            förbättra inkontinens och samtidigt tona upp gluteusmusklerna – helt
            utan ansträngning.
          </p>
          <p class="text-lg mb-6">
            Under en 28-minuters session genomför du motsvarande 11 000
            bäckenbottenövningar medan du sitter fullt påklädd i stolen.
            Teknologin stimulerar djupa muskelkontraktioner som är omöjliga att
            uppnå med konventionell träning.
          </p>
        </div>

        <!-- Features Box -->
        <div class="bg-white/70 rounded-lg p-8 shadow-lg">
          <h4 class="text-xl font-semibold mb-4">Behandlingens fördelar</h4>
          <ul class="space-y-3">
            <li class="flex items-start">
              <span class="text-2xl mr-3">💪</span>
              <span
                ><strong>Stärker bäckenbotten</strong> – minskar inkontinens och förbättrar
                blåskontroll</span
              >
            </li>
            <li class="flex items-start">
              <span class="text-2xl mr-3">🍑</span>
              <span
                ><strong>Formar och lyfter rumpa</strong> – tonar gluteusmusklerna
                för fastare resultat</span
              >
            </li>
            <li class="flex items-start">
              <span class="text-2xl mr-3">⚡</span>
              <span
                ><strong>Snabba sessioner</strong> – endast 28 minuter per behandling</span
              >
            </li>
            <li class="flex items-start">
              <span class="text-2xl mr-3">👔</span>
              <span
                ><strong>Fullt påklädd</strong> – bekväm och diskret behandling</span
              >
            </li>
            <li class="flex items-start">
              <span class="text-2xl mr-3">🚫</span>
              <span
                ><strong>Ingen återhämtningstid</strong> – återgå till vardagen direkt</span
              >
            </li>
            <li class="flex items-start">
              <span class="text-2xl mr-3">✨</span>
              <span
                ><strong>Dokumenterade resultat</strong> – kliniskt beprövad teknologi</span
              >
            </li>
          </ul>
        </div>
      </div>

      <!-- Treatment Process -->
      <div class="bg-white/60 rounded-lg p-8 mb-12">
        <h3 class="text-2xl md:text-3xl font-semibold mb-6">
          Så går behandlingen till
        </h3>
        <div class="grid md:grid-cols-3 gap-8">
          <div>
            <div
              class="bg-[#2f2011] text-white rounded-full w-12 h-12 flex items-center justify-center text-xl font-bold mb-4"
            >
              1
            </div>
            <h4 class="font-semibold text-lg mb-2">Konsultation</h4>
            <p>
              Vi går igenom dina mål och förväntningar. Bedömer om behandlingen
              passar för dig och svarar på alla dina frågor.
            </p>
          </div>
          <div>
            <div
              class="bg-[#2f2011] text-white rounded-full w-12 h-12 flex items-center justify-center text-xl font-bold mb-4"
            >
              2
            </div>
            <h4 class="font-semibold text-lg mb-2">Behandling</h4>
            <p>
              Du sitter bekvämt i stolen fullt påklädd i 28 minuter medan
              HIFEM-teknologin aktiverar djupa muskelkontraktioner.
            </p>
          </div>
          <div>
            <div
              class="bg-[#2f2011] text-white rounded-full w-12 h-12 flex items-center justify-center text-xl font-bold mb-4"
            >
              3
            </div>
            <h4 class="font-semibold text-lg mb-2">Direkt tillbaka</h4>
            <p>
              Ingen återhämtningstid behövs. Du kan återgå till dina dagliga
              aktiviteter omedelbart efter behandlingen.
            </p>
          </div>
        </div>
      </div>

      <!-- Who is it for -->
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white/60 rounded-lg p-8">
          <h3 class="text-2xl font-semibold mb-4">Passar för dig som</h3>
          <ul class="space-y-3">
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Upplever urinläckage vid skratt, hosta eller träning</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Vill stärka bäckenbotten efter graviditet</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Önskar en fastare och mer lyft rumpa</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Vill förbättra sexuell funktion och välbefinnande</span>
            </li>
            <li class="flex items-start">
              <span class="text-green-600 mr-2">✓</span>
              <span>Söker en icke-invasiv lösning utan kirurgi</span>
            </li>
          </ul>
        </div>

        <div class="bg-white/60 rounded-lg p-8">
          <h3 class="text-2xl font-semibold mb-4">Behandlingskur</h3>
          <div class="space-y-4">
            <div>
              <p class="font-semibold">Rekommenderad kur:</p>
              <p class="text-lg">6–8 behandlingar</p>
            </div>
            <div>
              <p class="font-semibold">Frekvens:</p>
              <p class="text-lg">2 behandlingar per vecka</p>
            </div>
            <div>
              <p class="font-semibold">Sessionstid:</p>
              <p class="text-lg">28 minuter per behandling</p>
            </div>
            <div>
              <p class="font-semibold">Första resultat:</p>
              <p class="text-lg">Efter 2–3 behandlingar</p>
            </div>
            <div>
              <p class="font-semibold">Optimalt resultat:</p>
              <p class="text-lg">2–4 veckor efter avslutad kur</p>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA Button -->
      <div class="mt-12 text-center">
        <a
          href="https://www.bokadirekt.se/places/zaras-halsofokus-40836"
          class="inline-block px-8 py-4 rounded-md bg-[#2f2011] text-white text-lg font-semibold hover:bg-[#1f1408] transition shadow-lg"
        >
          Boka din Insculpt Chair-behandling
        </a>
      </div>
    </div>
  </section>
</Layout>
