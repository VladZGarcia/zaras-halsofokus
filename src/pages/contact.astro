---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section class="min-h-screen flex items-center justify-center bg-[#4a3c2b] under-header">
    <div class="px-6 py-12 text-center max-w-3xl">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">Kontakta oss</h1>
      <p class="text-lg md:text-xl mb-8">
        Har du frågor eller vill boka en tid? Tveka inte att kontakta oss! Vi
        ser fram emot att höra från dig och hjälpa dig på din resa mot bättre
        hälsa och välbefinnande.
      </p>
      <a
        href="/"
        class="inline-block px-6 py-3 rounded-md border border-white/40 bg-white/15 text-white hover:bg-white/25 hover:border-white/60 transition"
        >Tillbaka</a
      >
    </div>
  </section>
</Layout>