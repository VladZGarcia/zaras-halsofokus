---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Kontakta oss - Boka behandling | Zaras Hälsofokus"
  description="Har du frågor om våra behandlingar? Kontakta Zaras Hälsofokus för LPG, Insculpt eller Insculpt Chair. Vi finns i Stockholm och hjälper dig gärna!"
>
  <main>
    <section id="contact-wrapper" class="relative overflow-hidden">
      <!-- Diagonal watermark band crossing full page width -->
      <div
        class="absolute inset-0 pointer-events-none z-10 flex items-center justify-center"
      >
        <div
          class="rotate-[-20deg] bg-yellow-500/40 text-black font-bold text-lg sm:text-xl md:text-2xl py-3 sm:py-4 px-8 shadow-lg whitespace-nowrap w-[400%]"
        >
          <div class="text-center">
            🚧 UNDER CONSTRUCTION / UNDER UPPBYGGNAD 🚧
          </div>
        </div>
      </div>

      <!-- Use a local header height variable to avoid affecting other pages -->
      <div
        class="pt-(--page-header-height,120px) min-h-[calc(100vh-var(--page-header-height,120px))] flex flex-col"
      >
        <div class="flex-1"></div>
        <div class="container mx-auto px-4 max-w-4xl pb-12 sm:pb-16 lg:pb-20">
          <div
            class="bg-white/10 ring-1 ring-white/20 backdrop-blur rounded-2xl p-6 md:p-8 relative"
          >
            <div class="mb-8 text-center">
              <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold">
                Kontakta oss
              </h1>
              <p class="mt-3 text-base sm:text-lg md:text-xl text-white/90">
                Fyll i formuläret så återkommer vi så snart som möjligt.
              </p>
              <!-- Success/Error messages -->
              <div id="form-message" class="hidden mt-4 p-4 rounded-lg"></div>
            </div>

            <form
              id="contact-form"
              method="POST"
              action="/api/send-email"
              class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6"
            >
              <!-- Namn -->
              <div class="col-span-1">
                <label class="block text-sm font-medium mb-1">Namn *</label>
                <input
                  type="text"
                  name="name"
                  required
                  placeholder="Ditt namn"
                  class="w-full rounded-lg bg-white/15 border border-white/25 px-4 py-3 text-white placeholder-white/60 focus:outline-none focus:ring-2 focus:ring-white/40"
                />
              </div>

              <!-- E-post -->
              <div class="col-span-1">
                <label class="block text-sm font-medium mb-1">E‑post *</label>
                <input
                  type="email"
                  name="email"
                  required
                  placeholder="namn@exempel.se"
                  class="w-full rounded-lg bg-white/15 border border-white/25 px-4 py-3 text-white placeholder-white/60 focus:outline-none focus:ring-2 focus:ring-white/40"
                />
              </div>

              <!-- Telefon -->
              <div class="col-span-1">
                <label class="block text-sm font-medium mb-1"
                  >Telefon (valfritt)</label
                >
                <input
                  type="tel"
                  name="phone"
                  placeholder="070‑123 45 67"
                  class="w-full rounded-lg bg-white/15 border border-white/25 px-4 py-3 text-white placeholder-white/60 focus:outline-none focus:ring-2 focus:ring-white/40"
                />
              </div>
              <!-- Ämne -->
              <div class="col-span-1">
                <label class="block text-sm font-medium mb-1"
                  >Ämne (valfritt)</label
                >
                <input
                  type="text"
                  name="subject"
                  placeholder="Vad gäller det?"
                  class="w-full rounded-lg bg-white/15 border border-white/25 px-4 py-3 text-white placeholder-white/60 focus:outline-none focus:ring-2 focus:ring-white/40"
                />
              </div>

              <!-- Meddelande -->
              <div class="md:col-span-2">
                <label class="block text-sm font-medium mb-1"
                  >Meddelande *</label
                >
                <textarea
                  name="message"
                  required
                  rows="6"
                  placeholder="Skriv ditt meddelande här"
                  class="w-full rounded-lg bg-white/15 border border-white/25 px-4 py-3 text-white placeholder-white/60 focus:outline-none focus:ring-2 focus:ring-white/40"
                ></textarea>
              </div>

              <!-- Knapprad -->
              <div
                class="md:col-span-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:justify-between mt-2"
              >
                <a
                  href="/"
                  class="inline-flex items-center justify-center w-full sm:w-auto px-5 py-3 rounded-lg border border-white/30 bg-white/10 text-white hover:bg-white/20 hover:border-white/50 transition"
                  >Tillbaka</a
                >
                <button
                  type="submit"
                  id="submit-btn"
                  class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 rounded-lg bg-blue-500 text-white hover:bg-blue-600 transition disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  <span id="btn-text">Skicka meddelande</span>
                  <span id="btn-loading" class="hidden">
                    <svg
                      class="animate-spin h-5 w-5 ml-2"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                    >
                      <circle
                        class="opacity-25"
                        cx="12"
                        cy="12"
                        r="10"
                        stroke="currentColor"
                        stroke-width="4"></circle>
                      <path
                        class="opacity-75"
                        fill="currentColor"
                        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                      ></path>
                    </svg>
                  </span>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  // Set a local CSS var for header height on this page only
  document.addEventListener("DOMContentLoaded", () => {
    const header = document.querySelector("header");
    const wrapper = document.getElementById("contact-wrapper");
    if (header && wrapper) {
      const h = header.offsetHeight;
      if (h > 0) {
        wrapper.style.setProperty("--page-header-height", `${h}px`);
      }
    }

    // Handle form submission
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const messageDiv = document.getElementById("form-message");

    if (!form || !messageDiv) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const submitBtn = form.querySelector(
        'button[type="submit"]',
      ) as HTMLButtonElement;
      const originalBtnText = submitBtn ? submitBtn.innerHTML : "Skicka";

      // Disable button and show loading state
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Skickar...";
      }

      messageDiv.classList.add("hidden");
      messageDiv.textContent = "";
      messageDiv.className = "hidden mt-4 p-4 rounded-lg";

      try {
        const formData = new FormData(form);
        const response = await fetch("/api/send-email", {
          method: "POST",
          body: formData,
        });

        const result = await response.json();

        if (response.ok && result.success) {
          // Success
          messageDiv.className =
            "mt-4 p-4 rounded-lg bg-green-500/20 border border-green-500/40 text-green-100 text-center";
          messageDiv.textContent =
            result.message || "Tack för ditt meddelande!";
          messageDiv.classList.remove("hidden");
          form.reset();
        } else {
          // Error
          messageDiv.className =
            "mt-4 p-4 rounded-lg bg-red-500/20 border border-red-500/40 text-red-100 text-center";
          messageDiv.textContent =
            result.error || "Ett fel uppstod. Försök igen.";
          messageDiv.classList.remove("hidden");
        }
      } catch (error) {
        // Network error
        messageDiv.className =
          "mt-4 p-4 rounded-lg bg-red-500/20 border border-red-500/40 text-red-100 text-center";
        messageDiv.textContent =
          "Kunde inte skicka meddelandet. Kontrollera din internetanslutning.";
        messageDiv.classList.remove("hidden");
      } finally {
        // Re-enable button
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalBtnText;
        }
      }
    });
  });
</script>
