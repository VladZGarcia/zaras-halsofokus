---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Om oss - Zaras Hälsofokus | Professionella behandlingar i Stockholm"
  description="Lär känna Zaras Hälsofokus. Vi erbjuder LPG, Insculpt och Insculpt Chair med fokus på individanpassade behandlingar och välmående. Välkommen till vår klinik i Stockholm."
>
  <section
    class="min-h-screen flex items-center justify-center bg-[#bfb6ad] under-header"
  >
    <div class="px-6 py-12 text-center max-w-4xl">
      <!-- Icon/Visual Element -->
      <div class="mb-8 flex justify-center">
        <svg
          class="w-20 h-20 md:w-24 md:h-24 text-[#2f2011]/60"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
          ></path>
        </svg>
      </div>

      <!-- Main Heading -->
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4 text-[#2f2011]"
      >
        Kommer snart
      </h1>

      <!-- Subtitle -->
      <p class="text-xl md:text-2xl mb-6 text-[#2f2011]/80 font-light">
        Vi arbetar med något spännande
      </p>

      <!-- Description -->
      <div class="mb-8 space-y-4 text-[#2f2011]/70">
        <p class="text-base md:text-lg max-w-2xl mx-auto">
          Vi förbereder en dedikerad sida där du kan lära känna oss och vårt
          team närmare.
        </p>
        <p class="text-base md:text-lg max-w-2xl mx-auto">
          Under tiden kan du utforska våra behandlingar eller kontakta oss
          direkt för mer information.
        </p>
      </div>

      <!-- Progress indicator (optional visual element) -->
      <div class="max-w-md mx-auto mb-8">
        <div class="h-1 bg-[#2f2011]/20 rounded-full overflow-hidden">
          <div class="h-full bg-[#2f2011]/60 rounded-full w-2/3 animate-pulse">
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href="/services"
          class="w-full sm:w-auto px-6 py-3 rounded-md border border-[#2f2011]/40 bg-[#2f2011]/90 text-white hover:bg-[#2f2011] hover:border-[#2f2011] transition font-medium"
        >
          Se våra tjänster
        </a>
        <a
          href="https://www.bokadirekt.se/places/zaras-halsofokus-40836"
          class="w-full sm:w-auto px-6 py-3 rounded-md border border-[#2f2011]/30 bg-white/60 text-[#2f2011] hover:bg-white hover:border-[#2f2011]/50 transition font-medium"
        >
          Boka behandling
        </a>
      </div>

      <!-- Back link (subtle) -->
      <div class="mt-10">
        <a
          href="/"
          class="text-sm text-[#2f2011]/60 hover:text-[#2f2011] transition underline"
        >
          ← Tillbaka till startsidan
        </a>
      </div>
    </div>
  </section>
</Layout>
