---
import Header from "../sections/Header.astro";
import Footer from "../sections/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;

// Get the current URL for canonical tag
const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || "https://www.zarashalsofokus.com",
);

// Default values
const pageTitle = title || "Zaras Hälsofokus";
const pageDescription =
  description ||
  "Zaras Hälsofokus är specialist på LPG-behandlingar i Stockholm. Personliga behandlingar för celluliter, cirkulation och välmående. Boka idag!";
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- Canonical URL - självrefererande för att undvika dubbletter -->
    <link rel="canonical" href={canonicalURL} />

    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon_ZH/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon_ZH/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon_ZH/favicon-16x16.png"
    />
    <link rel="shortcut icon" href="/favicon_ZH/favicon.ico" />
    <link rel="manifest" href="/favicon_ZH/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="keywords"
      content="Hälsa, Välmående, Kost, Träning, Mental hälsa, Livsstil, LPG, LPG massage, Insculpt, Insculpt Chair "
    />
    <meta name="author" content="Zara" />
    <meta name="robots" content="index, follow" />
    <meta name="language" content="Swedish" />
    <meta name="googlebot" content="index, follow" />
    <meta name="bingbot" content="index, follow" />
    <meta name="yandexbot" content="index, follow" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
  </head>
  <body>
    <Header />
    <div class="page-content">
      <slot />
    </div>
    <Footer />
  </body>
</html>

<style is:global>
  @import "tailwindcss";
  @import "tailwind-animations";
  html,
  body {
    color: white;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      Segoe UI,
      Roboto,
      Helvetica Neue,
      Arial,
      "Noto Sans",
      "Apple Color Emoji",
      "Segoe UI Emoji",
      "Segoe UI Symbol";
    margin: 0;
    width: 100%;
    height: 100%;
  }
  /* Use Playfair Display for headings to add contrast */
  h1,
  h2,
  h3 {
    font-family:
      "Playfair Display", Inter, ui-serif, Georgia, Cambria, "Times New Roman",
      Times, serif;
    letter-spacing: 0.01em;
  }
</style>
