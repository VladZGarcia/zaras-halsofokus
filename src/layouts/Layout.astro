---
import Header from "../sections/Header.astro";
import Footer from "../sections/Footer.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>Zaras Hälsofokus</title>
    <meta
      name="description"
      content="Zaras Hälsofokus är specialist på LPG-behandlingar i Stockholm. Personliga behandlingar för celluliter, cirkulation och välmående. Boka idag!"
    />
    <meta
      name="keywords"
      content="Hälsa, Välmående, Kost, Träning, Mental hälsa, Livsstil, LPG, LPG massage, Insculpt, Insculpt Chair "
    />
    <meta name="author" content="Zara" />
    <meta name="robots" content="index, follow" />
    <meta name="language" content="Swedish" />
    <meta name="googlebot" content="index, follow" />
    <meta name="bingbot" content="index, follow" />
    <meta name="yandexbot" content="index, follow" />
    <meta property="og:title" content="Zaras Hälsofokus" />
    <meta
      property="og:description"
      content="Zaras Hälsofokus är specialist på LPG-behandlingar i Stockholm. Personliga behandlingar för celluliter, cirkulation och välmående. Boka idag!"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://zarashalsofokus.com" />
  </head>
  <body>
    <Header />
    <div class="page-content">
      <slot />
    </div>
    <Footer />
  </body>
</html>

<style is:global>
  @import "tailwindcss";
  @import "tailwind-animations";
  html,
  body {
    color: white;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      Segoe UI,
      Roboto,
      Helvetica Neue,
      Arial,
      "Noto Sans",
      "Apple Color Emoji",
      "Segoe UI Emoji",
      "Segoe UI Symbol";
    margin: 0;
    width: 100%;
    height: 100%;
  }
  /* Use Playfair Display for headings to add contrast */
  h1,
  h2,
  h3 {
    font-family:
      "Playfair Display", Inter, ui-serif, Georgia, Cambria, "Times New Roman",
      Times, serif;
    letter-spacing: 0.01em;
  }
</style>
